  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Tombol aksi utama. Latar navy merek, teks primary-foreground.",
      "html": "<button class=\"ds-btn-primary\" type=\"button\">Simpan</button>",
      "css": ".ds-btn-primary {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  height: 36px;\n  padding: 0 16px;\n  border: 0;\n  border-radius: var(--radius-md);\n  background: hsl(var(--primary));\n  color: hsl(var(--primary-foreground));\n  font-family: var(--font-sans);\n  font-size: var(--text-body-sm-size);\n  font-weight: 500;\n  line-height: var(--text-body-sm-lh);\n  box-shadow: var(--elevation-2);\n  cursor: pointer;\n  transition: background-color 120ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 120ms cubic-bezier(0.16, 1, 0.3, 1), transform 120ms cubic-bezier(0.16, 1, 0.3, 1);\n}\n.ds-btn-primary:hover {\n  background: hsl(var(--primary) / 0.9);\n  box-shadow: var(--elevation-3);\n  transform: translateY(-1px);\n}\n.ds-btn-primary:focus-visible {\n  outline: 2px solid hsl(var(--ring));\n  outline-offset: 2px;\n}\n.ds-btn-primary:active {\n  transform: translateY(0);\n  box-shadow: var(--elevation-1);\n}\n.ds-btn-primary:disabled {\n  opacity: 0.5;\n  pointer-events: none;\n}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Kolom teks. Batas halus, latar transparan, tinggi 36px.",
      "html": "<input class=\"ds-input\" type=\"text\" placeholder=\"Cari data\" />",
      "css": ".ds-input {\n  display: block;\n  width: 100%;\n  height: 36px;\n  min-width: 0;\n  padding: 4px 12px;\n  border: 1px solid hsl(var(--input));\n  border-radius: var(--radius-md);\n  background: transparent;\n  color: hsl(var(--content-primary));\n  font-family: var(--font-sans);\n  font-size: var(--text-body-sm-size);\n  font-weight: 400;\n  line-height: var(--text-body-sm-lh);\n  box-shadow: var(--elevation-1);\n}\n.ds-input::placeholder { color: hsl(var(--content-tertiary)); }\n.ds-input:hover { border-color: hsl(var(--input)); }\n.ds-input:focus-visible {\n  outline: 2px solid hsl(var(--ring));\n  outline-offset: 2px;\n}\n.ds-input:disabled { opacity: 0.5; cursor: not-allowed; }"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Kartu default. Latar warm-100, sudut 10px, bayangan shadow-sm.",
      "html": "<article class=\"ds-card\"><h3 class=\"ds-card-title\">Ringkasan</h3><p class=\"ds-card-copy\">Data periode berjalan.</p></article>",
      "css": ".ds-card {\n  border: 1px solid hsl(var(--border-default));\n  border-radius: var(--radius-xl);\n  background: hsl(var(--card));\n  color: hsl(var(--card-foreground));\n  padding: 24px;\n  box-shadow: var(--shadow-sm);\n  font-family: var(--font-sans);\n}\n.ds-card-title {\n  margin: 0 0 6px;\n  font-size: 1rem;\n  font-weight: 600;\n  line-height: 1;\n  letter-spacing: -0.025em;\n  color: hsl(var(--content-primary));\n}\n.ds-card-copy {\n  margin: 0;\n  font-size: var(--text-body-sm-size);\n  line-height: var(--text-body-sm-lh);\n  color: hsl(var(--content-secondary));\n}\n.ds-card:hover { border-color: hsl(var(--border-default)); }\n.ds-card:focus-visible {\n  outline: 2px solid hsl(var(--ring));\n  outline-offset: 2px;\n}"
    },
    {
      "name": "Badge",
      "kind": "chip",
      "refersTo": "badge",
      "description": "Badge pill primer. Hover hanya saat menjadi tautan.",
      "html": "<a class=\"ds-badge\" href=\"#disetujui\">Disetujui</a>",
      "css": ".ds-badge {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: fit-content;\n  padding: 2px 8px;\n  border: 1px solid transparent;\n  border-radius: var(--radius-full);\n  background: hsl(var(--primary));\n  color: hsl(var(--primary-foreground));\n  font-family: var(--font-sans);\n  font-size: var(--text-caption-size);\n  font-weight: 500;\n  line-height: var(--text-caption-lh);\n  text-decoration: none;\n  white-space: nowrap;\n}\n.ds-badge:hover { background: hsl(var(--primary) / 0.9); }\n.ds-badge:focus-visible {\n  outline: 2px solid hsl(var(--ring));\n  outline-offset: 2px;\n}"
    },
    {
      "name": "Page Header",
      "kind": "custom",
      "description": "Judul halaman. Elemen h1 bertipografi heading 2, plus deskripsi dan slot aksi.",
      "html": "<header class=\"ds-page-header\"><div><h1 class=\"ds-page-title\">Ringkasan</h1><p class=\"ds-page-desc\">Data periode berjalan.</p></div><div class=\"ds-page-action\">Aksi</div></header>",
      "css": ".ds-page-header {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  padding-bottom: 16px;\n  border-bottom: 1px solid hsl(var(--border));\n  font-family: var(--font-sans);\n}\n.ds-page-title {\n  margin: 0;\n  font-size: var(--text-h2-size);\n  font-weight: var(--text-h2-weight);\n  line-height: var(--text-h2-lh);\n  letter-spacing: var(--text-h2-ls);\n  color: hsl(var(--foreground));\n}\n.ds-page-desc {\n  margin: 4px 0 0;\n  font-size: 0.875rem;\n  line-height: calc(1.25 / 0.875);\n  color: hsl(var(--muted-foreground));\n}\n.ds-page-action { flex-shrink: 0; color: hsl(var(--content-secondary)); font-size: var(--text-body-sm-size); }\n.ds-page-header:hover { border-bottom-color: hsl(var(--border)); }\n.ds-page-header:focus-visible {\n  outline: 2px solid hsl(var(--ring));\n  outline-offset: 2px;\n}\n@media (min-width: 768px) {\n  .ds-page-header { flex-direction: row; align-items: flex-end; justify-content: space-between; }\n}"
    },
    {
      "name": "KPI Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Kartu indikator. Tepi kiri navy, nilai mono tabular.",
      "html": "<article class=\"ds-kpi\"><p class=\"ds-kpi-title\">Responden</p><p class=\"ds-kpi-value\">1.240</p><p class=\"ds-kpi-helper\">+8% bulan ini</p></article>",
      "css": ".ds-kpi {\n  position: relative;\n  overflow: hidden;\n  border: 1px solid hsl(var(--border-default));\n  border-left: 4px solid hsl(var(--primary));\n  border-radius: var(--radius-xl);\n  background: hsl(var(--card));\n  color: hsl(var(--card-foreground));\n  padding: 24px;\n  box-shadow: var(--shadow-sm);\n  font-family: var(--font-sans);\n}\n.ds-kpi-title {\n  margin: 0 0 8px;\n  font-size: 0.75rem;\n  font-weight: 600;\n  line-height: calc(1 / 0.75);\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n  color: hsl(var(--muted-foreground));\n}\n.ds-kpi-value {\n  margin: 0;\n  font-family: var(--font-mono);\n  font-size: 1.5rem;\n  font-weight: 700;\n  line-height: calc(2 / 1.5);\n  font-variant-numeric: tabular-nums;\n  font-feature-settings: \"tnum\" 1;\n  letter-spacing: 0;\n  text-align: right;\n  color: hsl(var(--content-primary));\n}\n.ds-kpi-helper {\n  margin: 4px 0 0;\n  font-size: 0.75rem;\n  line-height: calc(1 / 0.75);\n  color: hsl(var(--muted-foreground));\n}\n.ds-kpi:hover { border-color: hsl(var(--border-default)); border-left-color: hsl(var(--primary)); }\n.ds-kpi:focus-visible {\n  outline: 2px solid hsl(var(--ring));\n  outline-offset: 2px;\n}"
    }
  ],
  "narrative": {
    "northStar": "Berkas ini mencatat token visual @bpsprovkaltara/design-system supaya aplikasi konsumen tetap pada sistem.",
    "overview": "Berkas ini mencatat token visual `@bpsprovkaltara/design-system` supaya aplikasi konsumen tetap pada sistem. Nilai di frontmatter adalah mode terang (`:root`) setelah alias semantik di-resolve ke kanal HSL. Sumber kanal itu `tokens.css`. Skala primitif hanya dipakai untuk mendefinisikan token semantik, bukan untuk diwarnai langsung di komponen.\n\nPaket ini CSS-first (Tailwind 4). Konsumen memakai token semantik `surface`, `content`, `border`, `brand`, dan `feedback`. Mode `.dark` menimpa token semantik yang sama; skala primitif tidak berubah. Salinan antarmuka Bahasa Indonesia formal, tanpa emoji.",
    "keyCharacteristics": [
      "Token semantik untuk komponen; primitif hanya bahan definisi.",
      "Warna disimpan sebagai kanal HSL mentah, dipakai lewat `hsl(var(--token))`.",
      "Fraunces untuk display, IBM Plex Sans untuk UI, IBM Plex Mono untuk angka.",
      "Radius tertahan dan enam tingkat elevasi bernuansa navy.",
      "Lapisan permukaan (kanvas, sunken, raised) lebih dulu daripada bayangan."
    ],
    "rules": [
      {
        "name": "The Semantic Token Rule",
        "body": "Komponen konsumen memakai `surface-*`, `content-*`, `border-*`, `brand-*`, `feedback-*`, dan `data-*`. Skala primitif `navy`, `amber`, `emerald`, `crimson`, `slate`, dan `warm` hanya mendefinisikan token itu.",
        "section": "colors"
      },
      {
        "name": "The Bare Channel Rule",
        "body": "Jangan menulis hex di komponen. Kanal disimpan mentah; pemakaiannya `hsl(var(--token))` atau utilitas Tailwind, termasuk opasitas `hsl(var(--token) / 0.9)`.",
        "section": "colors"
      },
      {
        "name": "The Type Role Rule",
        "body": "Fraunces tidak dipakai untuk tombol, input, atau tabel. IBM Plex Mono tidak dipakai untuk paragraf. Heading aplikasi tetap IBM Plex Sans.",
        "section": "typography"
      },
      {
        "name": "The Four Point Rule",
        "body": "Jangan mengarang jarak di luar skala `--space-*`. Padding komponen yang sudah ada (tombol 16px horizontal, kartu 24px) mengikuti langkah itu.",
        "section": "layout"
      },
      {
        "name": "The Surface Layer Rule",
        "body": "Jangan menambah bayangan baru untuk membedakan kartu dari halaman. Gunakan `surface-canvas`, `surface-sunken`, dan `surface-raised` lebih dulu. Bayangan yang dipakai komponen adalah elevation 0–5 dan `shadow-sm` di atas.",
        "section": "elevation"
      },
      {
        "name": "The Restrained Radius Rule",
        "body": "Tombol dan input tetap 6px. Jangan menukar kartu default ke pill atau ke sudut nol.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do pakai token semantik di komponen konsumen: `surface`, `content`, `border`, `brand`, `feedback`, dan `data`.",
      "Do simpan warna sebagai kanal HSL mentah dan pakai `hsl(var(--token))` atau utilitas Tailwind.",
      "Do impor CSS paket tepat sekali di root. Tailwind 4 memakai `tokens.css` sesudah `@import \"tailwindcss\"`. Non-Tailwind memakai `styles.css`.",
      "Do tulis salinan UI dalam Bahasa Indonesia formal, tanpa emoji, dan format angka dengan `Intl.NumberFormat('id-ID')`.",
      "Do andalkan token semantik yang sama untuk mode terang dan `.dark`."
    ],
    "donts": [
      "Don't hardcode hex di komponen konsumen.",
      "Don't pakai skala primitif (`navy`, `amber`, `emerald`, `crimson`, `slate`, `warm`) langsung di komponen.",
      "Don't mengimpor `styles.css` dan `tokens.css` sekaligus, dan jangan memakai `tailwind-preset` untuk integrasi baru.",
      "Don't menganggap latar kartu putih. Token `card` adalah warm-100; yang putih adalah `surface-raised`.",
      "Don't menganggap teks tombol primer `brand-primary-fg`. Varian default memakai `primary-foreground`.",
      "Don't memuat `fonts.css` sebagai default. Berkas itu CDN opsional."
    ]
  }
}
