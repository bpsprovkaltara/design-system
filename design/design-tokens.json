  "borderRadius": {
    "none":    "0px",
    "sm":      "0.25rem",
    "DEFAULT": "0.375rem",
    "md":      "0.375rem",
    "lg":      "0.5rem",
    "xl":      "0.75rem",
    "2xl":     "1rem",
    "full":    "9999px",
    "cssVar":  "--radius: 0.5rem",
    "usage": {
      "button":           "rounded-md (0.375rem)",
      "input":            "rounded-md (0.375rem)",
      "card":             "rounded-xl (0.75rem)",
      "badge":            "rounded-full (9999px)",
      "iconContainer":    "rounded-lg (0.5rem)",
      "avatar":           "rounded-full (9999px)",
      "sidebarItem":      "rounded-lg (0.5rem)",
      "progressBar":      "rounded-full (9999px)",
      "tabsList":         "rounded-lg (0.5rem)",
      "popover":          "rounded-md (0.375rem)"
    }
  },
  "shadows": {
    "sm":      "0 1px 2px 0 rgb(0 0 0 / 0.05)",
    "DEFAULT": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
    "md":      "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
    "lg":      "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
    "xl":      "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)",
    "none":    "none",
    "usage": {
      "card":        "shadow-sm (rest) → shadow-md (hover)",
      "button":      "shadow (default variant), shadow-sm (secondary/destructive/outline)",
      "popover":     "shadow-md",
      "input":       "shadow-sm"
    }
  },
  "breakpoints": {
    "sm":  "640px",
    "md":  "768px",
    "lg":  "1024px",
    "xl":  "1280px",
    "2xl": "1536px",
    "usage": {
      "sidebar":      "hidden below lg (1024px)",
      "headerSearch": "hidden below sm (640px)",
      "pageHeader":   "stacks below sm, row at sm+",
      "mainPadding":  "px-6 py-6 → px-8 py-8 at lg"
    }
  },
  "animation": {
    "duration": {
      "fast":    "150ms",
      "normal":  "200ms",
      "slow":    "300ms",
      "slower":  "500ms"
    },
    "easing": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "in":      "cubic-bezier(0.4, 0, 1, 1)",
      "out":     "cubic-bezier(0, 0, 0.2, 1)"
    },
    "usage": {
      "progressBar":   "transition-all duration-500 (500ms)",
      "buttonHover":   "transition-colors (150ms default)",
      "cardHover":     "transition-shadow",
      "sidebarItem":   "transition-colors",
      "overlayOpen":   "animate-in fade-in-0 zoom-in-95",
      "overlayClose":  "animate-out fade-out-0 zoom-out-95",
      "accordionOpen": "accordion-down",
      "accordionClose":"accordion-up"
    }
  }
}
