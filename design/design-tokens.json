  "typography": {
    "fontFamily": {
      "sans": ["Geist Sans", "system-ui", "sans-serif"]
    },
    "fontSize": {
      "xs":   "0.75rem",
      "sm":   "0.875rem",
      "base": "1rem",
      "lg":   "1.125rem",
      "xl":   "1.25rem",
      "2xl":  "1.5rem",
      "3xl":  "1.875rem",
      "4xl":  "2.25rem",
      "5xl":  "3rem"
    },
    "lineHeight": {
      "none":    "1",
      "tight":   "1.25",
      "snug":    "1.375",
      "normal":  "1.5",
      "relaxed": "1.625",
      "loose":   "2"
    },
    "fontWeight": {
      "normal":   "400",
      "medium":   "500",
      "semibold": "600",
      "bold":     "700"
    },
    "letterSpacing": {
      "tight":   "-0.025em",
      "normal":  "0em",
      "wide":    "0.025em",
      "wider":   "0.05em",
      "widest":  "0.1em"
    },
    "scale": {
      "pageTitle":    { "size": "1.25rem",  "weight": "600", "lineHeight": "1.375", "color": "navy-900", "usage": "Header h1 (page name)" },
      "sectionTitle": { "size": "0.875rem", "weight": "600", "lineHeight": "1.5",   "color": "navy-900", "usage": "PageHeader h2" },
      "cardTitle":    { "size": "1.5rem",   "weight": "700", "lineHeight": "1.25",  "color": "navy-900", "usage": "StatCard value" },
      "label":        { "size": "0.875rem", "weight": "500", "lineHeight": "1.5",   "color": "navy-500", "usage": "StatCard title, table headers" },
      "body":         { "size": "0.875rem", "weight": "400", "lineHeight": "1.5",   "color": "foreground", "usage": "Table cells, descriptions" },
      "caption":      { "size": "0.75rem",  "weight": "400", "lineHeight": "1.5",   "color": "navy-400", "usage": "Subtitles, timestamps" },
      "overline":     { "size": "0.6875rem","weight": "600", "lineHeight": "1.5",   "letterSpacing": "0.1em", "textTransform": "uppercase", "color": "navy-600", "usage": "Sidebar group labels" },
      "badge":        { "size": "0.6875rem","weight": "500", "lineHeight": "1.5",   "usage": "StatusBadge labels" },
      "kbd":          { "size": "0.6875rem","weight": "400", "fontFamily": "sans",  "usage": "Keyboard shortcut hints" }
    }
  },
